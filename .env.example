# --- core ------------------------------------------------------------------
DATABASE_URL="postgresql://podshar:podshar@localhost:5432/podshar?schema=public"
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# --- object storage (media mirror) -----------------------------------------
S3_ENDPOINT=""
S3_BUCKET="podshar-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- models ----------------------------------------------------------------
# Podshar the assistant. Without it the dog still answers, from the keyword
# table in src/lib/assistant/fallback.ts — he is just noticeably stupider.
ANTHROPIC_API_KEY=""           # console.anthropic.com, pay-as-you-go
ANTHROPIC_WORKSPACE_ID=""      # only if the key was made outside a workspace
OPENAI_API_KEY=""              # gallery vision comments, not yet built

# --- mail ------------------------------------------------------------------
# Password reset links. Without both of these the "forgot password" link is not
# offered at all, and a forgotten password has to be reset by the owner by hand.
# EMAIL_FROM must sit on a domain verified in Resend, or every send returns 422.
RESEND_API_KEY=""              # resend.com/api-keys
EMAIL_FROM="Podshar <no-reply@example.com>"

# --- community -------------------------------------------------------------
# The group chat behind the Telegram icon in the footer. It is an invite link,
# so it lives here and never in the code: this repository is public, and an
# invite written into the source is a way into the group for anyone who reads
# it. Unset, the icon is simply not drawn. On Vercel, set it in every
# environment — a tick on Production does not cover Preview.
TELEGRAM_INVITE_URL=""         # https://t.me/+...

# --- data providers --------------------------------------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SOUNDCLOUD_CLIENT_ID=""
# Brawl Stars cups. One key for the whole site, not one per person: each of the
# three only pastes their player tag on the profile page.
#
# The key is bound to an IP address, and Vercel has none — a function leaves
# from a different address every time. So the key must be created with
# RoyaleAPI's proxy address in its allowlist (45.79.218.79) and used through
# https://bsproxy.royaleapi.dev, never against api.brawlstars.com directly.
# Verified both ways: 200 through the proxy, 403 accessDenied.invalidIp direct.
# That also means a leaked key is useless from anywhere else.
BRAWL_STARS_API_TOKEN=""       # developer.brawlstars.com -> My Account -> Create New Key
STEAM_API_KEY=""               # Dota 2 via Steam / OpenDota
OPENDOTA_API_KEY=""
OPENWEATHER_API_KEY=""
TRANSPORT_API_BASE="https://transport.opendata.ch/v1"

# --- secret store ----------------------------------------------------------
# Music and finance credentials live here, not in Postgres. The DB stores only
# the reference key (MusicConnection.credentialRef, FinanceConnection.credentialRef).
SECRETS_PROVIDER="local"       # local | vault | doppler
SECRETS_ENCRYPTION_KEY=""      # 32-byte base64, only used when provider=local

# --- scrapers (Python service) ---------------------------------------------
SCRAPER_INTERNAL_TOKEN=""      # shared secret for the scraper -> Next ingest API
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="podshar/0.1"
